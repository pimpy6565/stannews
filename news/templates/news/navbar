<head>
        <meta charset="utf-8">
        
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        
     
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="stylesheet" href="">
        <style>
            img{
                max-width: 100%;
                max-height: 100%;
                margin: 0;
                width: 850px;
            }
        </style>
    </head>

        <nav class="navbar bg-primary" data-bs-theme="dark">
            <div class="container-fluid">
              <a class="navbar-brand" href="{% url 'index' %}">Pepsi Pennsauken News</a>
              <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasDarkNavbar" aria-controls="offcanvasDarkNavbar" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
              </button>
              <div class="offcanvas offcanvas-end text-bg-dark" tabindex="-1" id="offcanvasDarkNavbar" aria-labelledby="offcanvasDarkNavbarLabel">
                <div class="offcanvas-header">
                  <h5 class="offcanvas-title" id="offcanvasDarkNavbarLabel">Menu</h5>
                  <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body">
                  <ul class="navbar-nav justify-content-end flex-grow-1 pe-3">
                    <li class="nav-item">
                      <a class="nav-link active" aria-current="page" href="{% url 'index' %}">Home</a>
                    </li>
                    <li class="nav-item">
                      <a class="nav-link" href="{% url 'About' %}">Contact Information</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{% url 'Disclaimer' %}">Disclaimer</a>
                      </li>
  
                  </ul>

                </div>
                <div id="messages" style="height: 300px; overflow-y: auto; padding: 5px;">
                </div>
                <form id="chatForm">
                  {% csrf_token %}
                <input type="text" id="msg" placeholder="Chat Here....." name="msg" style="width: 80%;">
                <input type="submit">
              </form>
              </div>
            </div>
          </nav>
          <script>
            let input = document.getElementById("msg");

input.addEventListener("input", ()=> {
      input.value = input.value.toUpperCase();});
document.getElementById("chatForm").addEventListener("submit", function(e) {
    e.preventDefault(); // stop page reload

    let message = document.getElementById("msg").value;
  
    fetch("/msg", {
        method: "POST",
        headers: {
            "Content-Type": "application/x-www-form-urlencoded",
            "X-CSRFToken": document.querySelector('[name=csrfmiddlewaretoken]').value
        },
        body: "msg=" + encodeURIComponent(message)
    })
    .then(response => response.json())
    .then(data => {
        const messagesDiv = document.getElementById("messages");
        messagesDiv.innerHTML += "<p>" + data.msg + "</p>";
        document.getElementById("msg").value = "";

        // auto-scroll to newest message
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
    });
});
const messagesDiv = document.getElementById("messages");

fetch("/msg")
  .then(response => response.json())
  .then(data => {
      messagesDiv.innerHTML = ""; // clear old messages

      // data.msg is now an array of objects
      for (let i = 0; i < data.msg.length; i++) {
          const p = document.createElement("p");
          p.textContent = data.msg[i].text;  // get the text from each object
          messagesDiv.appendChild(p);
      }

      messagesDiv.scrollTop = messagesDiv.scrollHeight; // auto-scroll
  });
            </script>
         

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
